# ==============================================================================
# ACA ADVISOR S.A.S. - Configuracion de Entorno (Plantilla segura para Git)
# Copiar este archivo a .env y reemplazar todos los valores por secretos fuertes.
# NUNCA subir .env al repositorio.
# ==============================================================================

# --- Base de datos MySQL ---
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=empmonitor
MYSQL_USER=empuser
MYSQL_PASSWORD=CHANGE_ME_STRONG_MYSQL_PASSWORD

# --- Base de datos MongoDB ---
MONGO_USER=empuser
MONGO_PASSWORD=CHANGE_ME_STRONG_MONGO_PASSWORD
MONGO_DATABASE=empmonitor

# --- Redis (con autenticacion obligatoria) ---
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# --- Secretos criptograficos y de sesion ---
SESSION_SECRET=CHANGE_ME_RANDOM_HEX_64
JWT_ACCESS_TOKEN_SECRET=CHANGE_ME_RANDOM_HEX_64
JWT_REFRESH_TOKEN_SECRET=CHANGE_ME_RANDOM_HEX_64
CRYPTO_PASSWORD=CHANGE_ME_STRONG_CRYPTO_PASSWORD
INTERNAL_AUTH_SECRET=CHANGE_ME_RANDOM_HEX_48
SCREENSHOT_SIGNING_SECRET=CHANGE_ME_RANDOM_HEX_48

# --- Credenciales del Panel Administrador ---
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_ALLOWED_EMAILS=admin@empmonitor.local,admin
ADMIN_DETAILS={"name":"Admin User","first_name":"Admin","last_name":"User","email":"admin@empmonitor.local","username":"admin","product_id":1,"total_allowed_user_count":500,"begin_date":"2024-01-01","expire_date":"2030-12-31","timezone":"America/Bogota"}

# --- Seguridad HTTP / API ---
ENABLE_SWAGGER=false
ALLOWED_ORIGINS=http://192.168.0.155:8081,http://localhost:8081,http://127.0.0.1:8081
AUTH_RATE_LIMIT_MAX=60
SCREENSHOT_URL_TTL_SECONDS=3600
TRUST_PROXY_HOPS=1

# --- TLS / HTTPS con Caddy (usado con docker-compose.tls.yml) ---
SITE_ADDRESS=https://192.168.0.155
TLS_MODE=internal

# Opcional: activar clave de aprovisionamiento para /api/v3/auth/register cuando todos los agentes la envien
AGENT_ENROLLMENT_KEY=

# --- Respaldos remotos (opcional, Bloque C) ---
# Ejemplo rclone: BACKUP_REMOTE_DEST=gdrive:aca-advisor-backups
# Ejemplo rsync:  BACKUP_RSYNC_DEST=backupuser@192.168.0.200:/backups/aca-advisor
BACKUP_REMOTE_DEST=
BACKUP_RSYNC_DEST=
